# Copia este archivo a .env en el servidor y completa los valores.
# .env nunca entra a las imagenes (.dockerignore) ni debe subirse al repositorio.
# Genera los secretos con:  openssl rand -base64 48

# ---- Obligatorias (docker compose no arranca sin ellas) ----
DB_PASSWORD=
# 64+ caracteres; compartido por gateway y auth
JWT_SECRET=
# cifra las claves de API de los MikroTik guardadas en la base. Si cambia, hay
# que volver a cargar la clave de cada router.
NETWORK_CRYPTO_SECRET=

# ---- Primer arranque ----
# 12+ caracteres. Reemplaza la clave de fabrica del admin semilla; auth no arranca
# en produccion mientras esa clave siga activa. Puede quitarse despues.
SUPER_ADMIN_PASSWORD=

# ---- Dominio (HTTPS automatico con Let's Encrypt) ----
DD_DOMAIN=consola.tudominio.co
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- Base de datos ----
# DB_USER=postgres
# DB_NAME=ddconexiones

# ---- Respaldos (infra/backup/README.md) ----
# BACKUP_DIR=./backups
# BACKUP_HOUR=2
# BACKUP_RETENTION_DAYS=14

# ---- Comunicaciones (dd_ms_comms) ----
ANTHROPIC_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- n8n (infra/n8n/README.md); vacio = automatizaciones apagadas ----
AUTOMATION_SECRET=
N8N_TENANT_SLUG=
N8N_API_EMAIL=
N8N_API_PASSWORD=

# ---- Solo si la consola se sirve desde otro origen ----
# CORS_ALLOWED_ORIGINS=https://consola.tudominio.co
