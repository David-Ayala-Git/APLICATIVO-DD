# =============================================================================
#  UN SOLO .env PARA TODO EL ECOSISTEMA
# =============================================================================
# Copia este archivo a .env y completa los valores. .env nunca se sube a git
# (.gitignore) ni entra a las imagenes (.dockerignore).
#
#  - Render: Dashboard > Environment Groups > New "dd-env" > "Add from .env",
#    pega este archivo ya completo y vincula el grupo a los 8 servicios
#    (cada servicio > Environment > Link Environment Group).
#  - Local:  docker compose up -d --build
#
# Genera los secretos con:  openssl rand -base64 48
# o en PowerShell:          [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))

# ---- Spring (Render) ----
SPRING_PROFILES_ACTIVE=pdn,render
# Render no tiene Consul
SPRING_CLOUD_CONSUL_ENABLED=false
SPRING_CLOUD_CONSUL_CONFIG_ENABLED=false
CONSUL_HOST=localhost
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# ---- Base de datos: Supabase (infra/supabase/README.md) ----
# Connect > Session pooler (puerto 5432). Siempre con sslmode=require.
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.REF_DEL_PROYECTO
DB_PASSWORD=
DB_NAME=postgres
# 7 servicios x 2 = 14 conexiones: cabe en el pool de 15 del plan gratis de Supabase
DB_POOL_SIZE=2

# ---- Seguridad ----
# 64+ caracteres; el MISMO valor lo usan gateway y auth
JWT_SECRET=
# cifra las claves de API de los MikroTik guardadas en la base. Si cambia, hay
# que volver a cargar la clave de cada router.
NETWORK_CRYPTO_SECRET=
# 12+ caracteres. Reemplaza la clave de fabrica del admin semilla; auth no arranca
# en produccion mientras esa clave siga activa.
SUPER_ADMIN_PASSWORD=

# ---- Front (Vercel) ----
# Solo pesa si el front llama directo al gateway (sin el rewrite de vercel.json)
CORS_ALLOWED_ORIGINS=https://*.vercel.app

# ---- Red privada de Render: <nombre-del-servicio>:10000 ----
# 10000 es el puerto que Render asigna por defecto. Si Render le agrego un sufijo
# al nombre, copia el valor exacto de cada servicio en Connect > Internal.
AUTH_HOSTPORT=dd-ms-auth:10000
CRM_HOSTPORT=dd-ms-crm:10000
BILLING_HOSTPORT=dd-ms-billing:10000
NETWORK_HOSTPORT=dd-ms-network:10000
SUPPORT_HOSTPORT=dd-ms-support:10000
COMMS_HOSTPORT=dd-ms-comms:10000
REPORTS_HOSTPORT=dd-ms-reports:10000

# ---- Comunicaciones (dd_ms_comms) ----
# Vacios = esas funciones responden 502, el servicio arranca igual
ANTHROPIC_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- Solo docker compose (servidor propio) ----
DD_DOMAIN=localhost
# HTTP_PORT=80
# HTTPS_PORT=443
# BACKUP_DIR=./backups
# BACKUP_HOUR=2
# BACKUP_RETENTION_DAYS=14
# n8n (infra/n8n/README.md); vacio = automatizaciones apagadas
AUTOMATION_SECRET=
N8N_TENANT_SLUG=
N8N_API_EMAIL=
N8N_API_PASSWORD=
