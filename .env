# Variables de entorno del ecosistema completo (docker-compose.yml, perfil "pdn").
# Estos son valores de DESARROLLO/prueba. Para un despliegue real, reemplaza cada
# secreto por uno propio y nunca subas este archivo con credenciales reales a git.

# ---- Base de datos (Postgres / Supabase) ----
DB_USER=postgres
DB_PASSWORD=devpass
DB_NAME=ddconexiones

# ---- ddc_ms_auth: firma de JWT ----
# El api-gateway necesita el MISMO valor para verificar la firma de cada peticion.
JWT_SECRET=change-this-jwt-secret-before-any-real-deployment-1234567890

# ---- dd_front: origenes autorizados a llamar la API desde el navegador ----
# Solo pesa si la consola se sirve en un origen distinto al del gateway.
# Con "docker compose up" la consola queda en :8081 detras de nginx, que hace
# proxy a /api, y entonces el navegador nunca cruza de origen.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8081

# ---- ddc_ms_network: cifrado de credenciales de routers MikroTik ----
NETWORK_CRYPTO_SECRET=change-this-network-secret-before-any-real-deployment

# ---- ddc_ms_comms: IA (Anthropic) y WhatsApp Cloud API ----
# Sin estos valores reales, /api/ai/agents/{id}/chat y /api/whatsapp/send
# responden 502 (fallan limpio al llamar a la API externa correspondiente).
ANTHROPIC_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token
